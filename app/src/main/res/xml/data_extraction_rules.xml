<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的数据迁移规则：设置项走云备份，设备间迁移不带走 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
